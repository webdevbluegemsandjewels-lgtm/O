# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it.

# ---- Browser client (js/supabaseClient.js — see scripts/build-config.js) ----
# Supabase Dashboard → Settings → API. The anon/public key is safe to
# expose in frontend code (never put the service_role key here).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Local image-upload tooling (s3Client.js / storage.js) ----
# Supabase Dashboard → Settings → Storage → S3 Connection.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_BUCKET_NAME=
